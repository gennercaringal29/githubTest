        function deleteRecord(req, id, status, permission = "") {
            req = req;
            id = id;
            status = status;
            swal({
                title: "Are you sure?",
                text: "Are you sure you want to delete this record?",
                icon: "warning",
                buttons: true,
                dangerMode: true,
            })
                .then((willDelete) => {
                    if (willDelete) {
                        confirmClick(req, id, status, permission);
                    }
                });
        }

        function confirmClick(req, id, status, permission = "") {
            $.ajax({
                type: 'POST',
                url: deletecountry, // change
                data: { "req": req, "pk_id": id, "stat": status, "permission": permission },
                dataType: 'json',
                success: function (data) {
                    window.location.href = mappermaint; //change
                }
            });
        }

        function crudCountry(req, id, status) { //change
            if (req == "Save") {
                var title = "Are you sure?";
                var text = "Make sure your informations are correct.";
                var icon = "warning";
            }

            if ($("#tieupForm").valid()) { //change

                $("form").submit(function (e) {
                    e.preventDefault();
                });

                swal({
                    title: title,
                    text: text,
                    icon: icon,
                    buttons: true,
                    dangerMode: true,
                }).then((willCrud) => {
                    if (willCrud) {
                        var form = $("#tieupForm").serialize() + '&req=' + req + '&id=' + id + '&status=' + status; //change
                        $.ajax({
                            type: 'POST',
                            url: editcountry, // change
                            data: form,
                            dataType: 'json',
                            success: function (data) {
                                window.location.href = mappermaint; //change
                            }
                        });
                    }
                });
            }
        }

