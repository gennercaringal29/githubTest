                        buttons: true,
                        dangerMode: true,
                    }).then((willCrud) => {
                        if (willCrud) {
                            var form = $("#EditForm").serialize() + '&req=' + req + '&id=' + id + '&status=' + status;
                            $.ajax({
                                type: 'POST',
                                url: editcountry,
                                data: form,
                                dataType: 'json',
                                success: function (data) {
                                    var title = data.title;
                                    var text = data.text;
                                    var icon = data.icon;
                                    if (icon == "error") {
                                        swal({
                                            title: title,
                                            text: text,
                                            icon: icon,
                                        });
                                    } else {
                                        swal({
                                            title: "Amendment",
                                            text: "Amendment request has been successfully submitted for approval",
                                            icon: "success",
                                        }).then(() => {
                                            window.location.href = mappermaint;
                                        });
                                    }
                                }
                            });
                        }
                    });
                }
            }
        }

        function alertMessage() {
            swal({
                title: "Alert!",
                text: "Configure at least one pair—(1) Settlement Amount & Currency or (2) Funding Amount & Currency. Both are allowed if necessary",
                icon: "warning"
            });
        }

    </script>


}
