    $(document).ready(function () {
        var table = $("#myTableDetail1"); // Target only this table

        // On page load: disable all 4th column input fields within this table
        table.find("tr").each(function () {
            var secondColumnField = $(this).find("td:nth-child(2) input[type='text']");
            var thirdColumnField = $(this).find("td:nth-child(3) input[type='text']");
            var inputField = $(this).find("td:nth-child(4)").find("input[type='text'], select");
            var checkbox = $(this).find("td:nth-child(5) input[type='checkbox']");

            inputField.prop("disabled", true); // Disable input initially

            if (inputField.val() !== "") {
                checkbox.prop("checked", true);
                inputField.prop("disabled", false);

                secondColumnField.prop("disabled", true);
                thirdColumnField.prop("disabled", true);
            }

            checkbox.on("change", function () {
                if (!$(this).is(":checked")) {
                    inputField.prop("disabled", true).val("");
                    inputField.closest("td").find(".text-danger").text(""); // Remove error message only in column 4
                } else {
                    inputField.prop("disabled", false);
                    secondColumnField.closest("td").find(".text-danger").text("");
                    thirdColumnField.closest("td").find(".text-danger").text("");
                }
            });
        });

        // When the checkbox is clicked
        table.find("td:nth-child(5) input[type='checkbox']").on("change", function () {
            var row = $(this).closest("tr");
            var secondColumnField = row.find("td:nth-child(2) input[type='text']");
            var thirdColumnField = row.find("td:nth-child(3) input[type='text']");
            var inputField = row.find("td:nth-child(4)").find("input[type='text'], select");

            if ($(this).is(":checked")) {
                secondColumnField.prop("disabled", true).val(""); // Disable & clear 2nd column
                thirdColumnField.prop("disabled", true).val(""); // Disable & clear 3rd column
                inputField.prop("disabled", false);
            } else {
                secondColumnField.prop("disabled", false);
                thirdColumnField.prop("disabled", false);
                inputField.prop("disabled", true).val("");
            }
        });

        // Sorts all disabled checkboxes at the bottom within this table
        var tableBody = table.find("tbody");
        if (tableBody.length === 0) {
            tableBody = table;
        }

        var rows = table.find("tr").get();

        rows.sort(function (a, b) {
            var aNotReq = $(a).find("td:nth-child(5) input[type='checkbox']").hasClass("provided_notReq");
            var bNotReq = $(b).find("td:nth-child(5) input[type='checkbox']").hasClass("provided_notReq");

            return aNotReq - bNotReq; // Moves "notReq" checkboxes to the bottom
        });

        $.each(rows, function (index, row) {
            tableBody.append(row);
        });

        // Adding asterisks to required fields
        table.find("td:nth-child(5) input[type='checkbox'].provided").each(function () {
            var row = $(this).closest("tr");
            var firstColumn = row.find("td:nth-child(1)"); // Target the first column

            if (!$(this).prop("disabled")) {
                firstColumn.append(" <span class='required' style='color:red;'>*</span>");
            }
        });
    });




