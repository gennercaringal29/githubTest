                    $("#myTableDetail1 .length-column").hide();
                    $(".myTableDetail tr > *:nth-child(3)").hide();
                    $("#dLimiter").text("");
                    $("#valDelimiter").text("");
                }
                else if (selectedFileType == TXT || selectedFileType == "others") {
                    $("#footerCheckBox").show();
                    $("#parentDelimiterDiv").show();
                    $(".delimiterGroup").hide();
                    $("#delimiter_val").hide();

                    if ((selectedFileType === "others" || selectedFileType == "txt") && $("#delimiterType").val() == "Delimiter") {
                        $(".delimiterGroup").show();
                        $("#delimiter_val").show();
                    }
                }
            });

            //Delimiter Type
            $("#delimiterType").on("change", function () {

                const delimiterType = document.getElementById("delimiterType").value;
                const delimiterLabel = document.getElementById("delimiterLabel");
                const delimiterDropdown = document.getElementById("delimiterDropdown");
                const delimiterTextbox = document.getElementById("delimiterTextbox");
                const prefix = document.getElementById("prefix");
                const prefixLabel = document.getElementById("prefix_label");

                if (delimiterType === "Delimiter") {
                    delimiterLabel.style.display = "block";
                    delimiterDropdown.style.display = "block";

                    prefix.style.display = "none";
                    prefixLabel.style.display = "none";
                    $("#d_pefix").text("");
                    $("#app_prefix").val("");

                } else {
                    delimiterLabel.style.display = "none";
                    delimiterDropdown.style.display = "none";
                    prefix.style.display = "block";
                    prefixLabel.style.display = "block";
                    delimiterTextbox.style.display = "none";
                }

                var elements = document.querySelectorAll('[id$="_length"]');
                elements.forEach(function (element) {
                    element.value = '';
                });

                var selectedDelimiterType = $("#delimiterType").val();
                $("#delimiter_type_message").text("");

                if (selectedDelimiterType == DELIMITER) {
                    $(".delimiterGroup").show();
                    $("#delimiter_val").hide();
                    $("#myTableDetail1 .length-column").hide();
                    $(".myTableDetail tr > *:nth-child(3)").hide();
                }
                else if (selectedDelimiterType == FIXED_LENGTH) {
                    $(".delimiterGroup").hide();
                    $("#delimiter_val").hide();
                    $("#delimiter")[0].selectedIndex = 0;

                    //show length td
                    $("#myTableDetail1 .length-column").show();
                    $(".myTableDetail tr > *:nth-child(3)").show();
                    $("#dLimiter").text("");
                    $("#valDelimiter").text("");

                } else if (selectedDelimiterType == NO_SELECTED_FILE_TYPE) {
                    $(".delimiterGroup").hide();
                    $("#delimiter_val").hide();
                    $("#delimiter")[0].selectedIndex = 0;
                    $("#myTableDetail1 .length-column").hide();
                }
            });

            //Delimiter
            $("#delimiter").on("change", function () {

                var selectedDelimiter = $("#delimiter").val();
                $("#valDelimiter").text("");

                if (selectedDelimiter == OTHER) {
                    $("#delimiter_val").show();
                    $("#dLimiter").text("");
                    $("#delimiter_val").val("");
                }
                else {
                    $("#delimiter_val").hide();
                    $("#valDelimiter").text("");
                    $("#delimiter_val").val("");
                }
            });

            var $content = $('.menu-content');
            function showContent(type) {
                $content.hide().filter('.' + type).show();
            }
            var $subContent = $('.menu-subContent');
            function showSubContent(type) {
                $subContent.hide().filter('.' + type).show();
            }

            $('.menu').on('click', '.menu-btn', function (e) {
                // get the type to pass to showContent by grabbing
                // the hash from the anchor href and removing the first
                // character (the #)
                showContent(e.currentTarget.hash.slice(1));
                e.preventDefault();
            });

            $('.submenu').on('click', '.submenu-btn', function (e) {
                showSubContent(e.currentTarget.hash.slice(1));
                e.preventDefault();
                $(".menus").show();
            });

            // show 'detail' content only on page load
            showContent('detail');
            $(".menus").hide();


        });



