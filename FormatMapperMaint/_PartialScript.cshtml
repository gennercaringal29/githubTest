        var DeletePkId = "";
    $('#tieuplist tbody').on('click', '.btnDelete', function () {
            const pkId = this.getAttribute('data-pk');
            DeletePkId = pkId;

            var tieup = {
                tieup_code_id: pkId
            };

            $.ajax({
                type: 'POST',
                url: '@Url.Action("CheckDuplicateRequest", "FormatMapperMaint")',
                //data: { i: pkId },
                data: tieup,
                dataType: 'json',
                statusCode: {
                    401: function () {
                        window.location = "/oops.html";
                    }
                },
                success: function (data) {
                    if (data.icon == 'error') {
                        swal({
                            title: "Unable to Delete!",
                            text: data.text,
                            icon: data.icon
                        }).then(() => {
                            window.location.reload(); // Reload the page if there are duplicates
                        });
                    } else {
                        $("#txtRemarks").val('');
                        $('#modalremarks').modal('show');
                    }
                }
            });
        });


        $('#btnConfirmDelete').click(function () {
            var pkId = DeletePkId;
            console.log("pkId " + pkId);
            var remarks = $("#txtRemarks").val();

            if (remarks.length < 1) {
                $("#txtRemarks").next(".text-danger").text("Remarks is required.");
                return false;
            } else {
                confirm_clicked(pkId, remarks);
            }
        });

    $("#modalremarks").on('hide.bs.modal', function () {
        $("#txtRemarks").val('');
        $("#txtRemarks").next(".text-danger").text('');
    });


    function confirm_clicked(pkId, remarks) {
        $("form").submit(function (e) {
            e.preventDefault();
        });

        if ($("#tieupForm").valid()) {
            swal({
                title: "Delete",
                text: "Are you sure you want to delete this record?",
                icon: "warning",
                buttons: true,
                dangerMode: true,
            }).then((willDelete) => {
                if (willDelete) {
                    $.ajax({
                        type: 'POST',
                        async: false,
                        url: toDeleteRecord,
                        data: { i: pkId, remarks: remarks },
                        dataType: 'json',
                        statusCode: {
                            401: function () {
                                window.location = "/oops.html";
                            }
                        },
                        success: function (data) {
                            if (data === "OK") {
                                swal({
                                    title: "Delete",
                                    text: "Deletion request has been successfully submitted for approval.",
                                    icon: "success",
                                    closeOnClickOutside: false
                                }).then((okayed) => {
                                    if (okayed) {
                                        /*window.location.href = view_;*/
                                        $("#txtRemarks").val("");
                                        $('#modalremarks').modal('hide');
                                        window.location.reload();
                                    }
                                });
                            } else {
                                alert(data);
                            }
                        }
                    });
                }
            });
        }
    }

