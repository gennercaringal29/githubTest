    $(document).ready(function () {
        var fundCur = document.getElementById('funding_currency');
        var settleCur = document.getElementById('settlement_currency');

        $('#settlement_currency').change(function () {

            var validate = $(this).val();

            if (fundCur.value === "PHP" && settleCur.value === "USD") {
                swal({
                    title: "Alert!",
                    text: "Invalid Settlement Currency",
                    icon: "warning",
                }).then(() => {
                    $(this).val("");
                });
            } else if (fundCur.value === "STC" && validate === "Funding Currency") {
                swal({
                    title: "Alert!",
                    text: "Invalid Settlement Currency",
                    icon: "warning",
                }).then(() => {
                    $(this).val("");
                });
            }
            
        });

        $('#funding_currency').change(function () {

            if (fundCur.value == "PHP" && settleCur.value == "USD") {
                swal({
                    title: "Alert!",
                    text: "Invalid Funding Currency",
                    icon: "warning",
                }).then(() => {
                    $(this).val("");
                });
            } else if (fundCur.value == "STC" && settleCur.value == "Funding Currency") {
                swal({
                    title: "Alert!",
                    text: "Invalid Funding Currency",
                    icon: "warning",
                }).then(() => {
                    $(this).val("");
                });
            }

        });

        

    });

