                        }).then(() => {
                            //window.location.reload(); // Reload the page if there are duplicates
                        });
                    } else {
                        window.location.href = '@Url.Action("MaintEditFormatMapper", "FormatMapperMaint")?i=' + pkId;
                    }
                }
            });
    });

