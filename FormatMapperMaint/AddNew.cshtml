@model DARS.Web.Models.FormatMapperFormViewModel
@using DARS.Web.Business
@using VREMIT.Auth

@{
    ViewBag.Title = "Format Mapper Maintenance";
    Layout = "~/Views/Shared/_Layout.cshtml";

    int? status = ViewBag.Status as int?;
    string success = ViewBag.SuccessMessage as string;
    string error = ViewBag.ErrorMessage as string;

}

@section css
{
    <style>

        #fieldNameTable.dataTable tbody tr:hover {
            color: floralwhite;
            background-color: #e60000;
        }

        #fieldNameTable.dataTable tbody tr.selected {
            color: floralwhite;
            background-color: #e60000;
        }

        .search-width {
            width: 100% !important;
            margin: 0 1rem;
        }

        select {
            text-align-last: center;
        }

        .hide-button {
            background-color: red !important;
            color: white !important;
        }

        .table-striped tbody tr:nth-child(odd) {
            background-color: #f9f9f9; /* Light gray */
        }

        .table-striped tbody tr:nth-child(even) {
            background-color: #ffffff; /* White */
        }

        .text-danger {
            position: absolute; /* Removes space when hidden */
            visibility: hidden; /* Hides the message but keeps it in place */
        }

            .text-danger:empty {
                display: none; /* If there's no message, remove it completely */
            }

            .text-danger:not(:empty) {
                visibility: visible; /* Show only when there's an actual message */
                position: relative; /* Restore normal position when needed */
            }

        tr {
            padding: 0;
        }

        td {
            padding: 0;
            vertical-align: middle !important;
        }

        ., .col-md-15 {
            margin-top: 0.5rem;
            margin-bottom: 0.75rem;
        }

        .provided {
            transform: scale(1.2); /* Slightly increase the checkbox size */
            margin: 0; /* Remove extra spacing */
        }

        .table-header {
            background-color: red !important; /* Force red background */
            color: white !important; /* Force white text */
            text-align: center; /* Center text horizontally */
            vertical-align: middle; /* Center text vertically */
            padding: 10px; /* Adds padding for better spacing */
            border: 1px solid white; /* Optional: Add white border for clarity */
        }
    </style>
}

@if (status != null)
{
    <div class="row" id="error_div">
        <div class="col-md-12">
            @{Html.RenderPartial("_PartialGenericStatus", new DARS.Web.Models.GenericStatusViewModel
                {
                    Status = status,
                    SuccessMessage = success,
                    ErrorMessage = error
                });}
        </div>
    </div>
}

