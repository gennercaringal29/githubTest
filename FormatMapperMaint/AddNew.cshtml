@section Scripts
{
    @Html.Partial("_PartialScript")

    <script>

        function toggleOtherInputField() {
            const delimiterValue = document.getElementById("delimiter").value;
            const delimiterTextbox = document.getElementById("delimiterTextbox");

            if (delimiterValue === "Other") {
                delimiterTextbox.style.display = "block";
            } else {
                delimiterTextbox.style.display = "none";
            }
        }

        $(".defaultDataValue:visible").css("background-color", "#ffffff");
    </script>
}
