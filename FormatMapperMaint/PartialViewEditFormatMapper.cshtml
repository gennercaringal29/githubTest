<div>
    <div class="row mb-4 align-items-center">
        <label class="col-md-auto col-form-label">Start Record <span style="color:red;">*</span> </label>
        <div class="col-md-auto">
            @Html.TextBoxFor(m => m.TieupViewDetailInputs.detail_start_record, new { @class = "form-control track-changes", @id = "detail_start_record" })
            @Html.ValidationMessageFor(m => m.TieupViewDetailInputs.detail_start_record, "", new { @class = "text-danger" })
        </div>

        <label class="col-md-auto col-form-label" id="prefix_label" style="display: none;">Application Number Prefix</label>
        <div class="col-md-auto" id="prefix" style="display: none">
            @Html.TextBoxFor(m => m.TieupViewDetailInputs.d_prefix, new
            {
           @class = "form-control",
           @placeholder = "prefix(e.g. FT)",
           @id = "app_prefix"
            })
            @Html.ValidationMessageFor(m => m.TieupViewDetailInputs.d_prefix, "", new { @class = "text-danger", @id = "d_pefix" })
        </div>
    </div>
</div>

<br />

