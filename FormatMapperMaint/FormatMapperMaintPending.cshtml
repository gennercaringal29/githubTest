@using DARS.Web.Business;
@{
    ViewBag.Title = "Format Mapper Maintenance";
    Layout = "~/Views/Shared/_Layout.cshtml";

    IList<VREMIT.ModelMVC.Tieup_Codes_Request> banks_pending = ViewBag.BanksPending;

    int? status = ViewBag.Status as int?;
    string success = ViewBag.SuccessMessage as string;
    string error = ViewBag.ErrorMessage as string;
}

@section css
{
    <style>
        .search-width {
            width: 100% !important;
            margin: 0 1rem;
        }

        select {
            text-align-last: center;
        }

        .btn-right {
            float: right;
        }
    </style>
}

@if (status != null)
{
    <div class="row" id="error_div">
        <div class="col-md-12">
            @{Html.RenderPartial("_PartialGenericStatus", new DARS.Web.Models.GenericStatusViewModel
                {
                    Status = status,
                    SuccessMessage = success,
                    ErrorMessage = error
                });}
        </div>
    </div>
}

<div class="card">
    <div class="card-content">

        @*// Form Title Path*@
        @*<label class="card-header" id="formTitle"></label>*@

        @using (Html.BeginForm("FormatMapperMaintPending", "FormatMapperMaint", FormMethod.Post, new { @class = "form", @id = "form1" }))
        {
            @Html.AntiForgeryToken()

            <div class="card-body">
                <h4 class="form-section"><i class="la la-ellipsis-v"></i> Pending Approval</h4>

                @Html.Partial("_PartialSearchPending")

                <div class="form-group">
                    <div class="row">
                        <div class="table-responsive">
                            <table id="datatablelist" class="table table-striped table-bordered compact" style="width:100%">
                                <thead>
                                    <tr>
                                        <th>Tie-Up</th>
                                        <th>File Type</th>
                                        <th>Status</th>
                                        <th>Action</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    @foreach (var item in banks_pending)
                                    {
                                        <tr>
                                            <td>@item.tieup_codes</td>
                                            <td>@item.file_type</td>
                                            <td>@Html.PendingRequestStatus(item.req_type)</td>
                                            <td style="text-align: center">
                                                <a href="@Url.Action("MaintFormatMapperPendingDetail","FormatMapperMaint", new { id = item.pk_tieup_code_id, status = item.status, reqtype = item.req_type})" class="btn btn-primary btn-sm">View</a>
                                            </td>
                                        </tr>
                                    }
                                </tbody>
                            </table>
                        </div>
                    </div>
                    <br />
                    <div class="row" align="center">
                        <div class="col-md-12 col-lg-12">
                            <a href="#" class="btn btn-primary"
                               onclick="location.href='@Url.Action("Index", "FormatMapperMaint")'">Back</a>
                        </div>
                    </div>
                </div>
            </div>

        }
    </div>
</div>

@section scripts{
    <script type="text/javascript">

        if ("@ViewBag.stext" != "") {
            swal({
                title: "@ViewBag.stitle",
                text: "@ViewBag.stext",
                icon: "@ViewBag.sicon"
            })
        }

        $(document).ready(function () {

            $('#datatablelist').DataTable({
                "aaSorting": [],
                "columnDefs": [
                    {
                        "orderable": false,
                        "targets": [3]
                    }
                ],
                "info": false,
                "lengthMenu": [10, 20, 50, 100],
                "pageLength": 20,
                "lengthChange": true,
                "sDom": '<"top"l>rt<"hidden"f><"bottom"ip><"clear">',
                "language": {
                    "searchPlaceholder": "Search any fields",
                    "emptyTable": "No data found"
                },
                "initComplete": function () {
                    $('div.dataTables_length select').addClass('form-select');
                }
            });
        });

        // Multi Search --

        //for auto search while typing
        $('#global_filter').on('input', function () {
            filterGlobal()
        });

        function filterGlobal() {
            $('#datatablelist').DataTable().search(
                $('#global_filter').val(),
                $('#global_regex').prop('checked'),
                $('#global_smart').prop('checked')
            ).draw();
        }

        function multiSearch() {
            $("form").submit(function (e) {
                e.preventDefault();
            });
            $('#datatablelist').DataTable().search('').columns().search('').draw();
            filterGlobal();
            filterColumn($('#col0_filter').parents('div').attr('data-column'));
            filterColumn($('#col1_filter').parents('div').attr('data-column'));
            filterColumn($('#col2_filter').parents('div').attr('data-column'));
        }

        function filterColumn(i) {
            var dataTable = $('#datatablelist').DataTable();
            var colValue = $('#col' + i + '_filter').val();

            if (colValue !== "") {
                if (i == 3) {
                    var inputDate = new Date(colValue);
                    colValue = inputDate.toLocaleDateString();
                }
                dataTable.column(i).search(colValue).draw();
            }
        }

        function clearTxt() {
            $("form").submit(function (e) {
                e.preventDefault();
            });

            var fields = document.getElementsByTagName('input'), length = fields.length;

            while (length--) {
                if (fields[length].type === 'text') { fields[length].value = ''; }
            }

            $('#datatablelist').DataTable().search('').columns().search('').draw(); // table name
            $('#col0_filter').val(''); // dropdown
            $('#col1_filter').val('');
            $('#col2_filter').val('');
        }

        function expandSearch() {
            document.getElementById('expandItem').hidden = false;
            document.getElementById('searchBtn').hidden = false;
            document.getElementById('shrink').hidden = false;
            document.getElementById('expand').hidden = true;
            document.getElementById('global_filter').hidden = true;
            document.getElementById('global_filter').value = "";
        }

        function shrinkSearch() {
            document.getElementById('expandItem').hidden = true;
            document.getElementById('searchBtn').hidden = true;
            document.getElementById('shrink').hidden = true;
            document.getElementById('expand').hidden = false;
            document.getElementById('global_filter').hidden = false;
            document.getElementById('global_filter').value = "";
        }

    </script>
}
